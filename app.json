{
  "expo": {
    "name": "Finch",
    "slug": "finch",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#6B4DFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finch.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B4DFF"
      },
      "package": "com.finch.app"
    },
    "plugins": ["expo-sqlite"]
  }
}
